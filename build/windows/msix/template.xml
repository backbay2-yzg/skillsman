<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="skillsman.exe"
        Arguments=""
        InstallLocation="C:\Program Files\SkillsMan\SkillsMan">
    </Installer>
    <PackageInformation
        PackageName="SkillsMan"
        PackageDisplayName="SkillsMan"
        PublisherName="CN=SkillsMan"
        PublisherDisplayName="SkillsMan"
        Version="1.0.0.0"
        PackageDescription="Lightweight Windows Skills Manager">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.skillsman.desktop"
                Description="Lightweight Windows Skills Manager"
                DisplayName="SkillsMan"
                ExecutableName="skillsman.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>SkillsMan</DisplayName>
            <PublisherDisplayName>SkillsMan</PublisherDisplayName>
            <Description>Lightweight Windows Skills Manager</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="skillsman.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
